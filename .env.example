APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Docker Compose maps the API on 8000; local `php artisan serve` typically uses 8001.
APP_URL=http://localhost:8000

# Base URL of the merchant PWA. Used to build the email verification deep link
# so merchant users land on the frontend instead of the API host.
MERCHANT_APP_URL=http://localhost:5173

# Base URI used to build RFC 9457 problem "type" values. Defaults to APP_URL/problems.
API_PROBLEM_BASE_URL=http://localhost:8000/problems

# Bootstrap super admin account created by SuperAdminSeeder.
SUPER_ADMIN_EMAIL=superadmin@jualantar.test
SUPER_ADMIN_PHONE=+6282252648923
SUPER_ADMIN_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OBSERVABILITY_ENABLED=true
PROMETHEUS_METRICS_ADAPTER=in_memory

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jualantar
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SCHEMA=public,identity_access,customer,geography,bank_directory,service,merchant,payout,notifications

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jualantar.local"
MAIL_FROM_NAME="JualAntar"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Provider-neutral object storage (Storage module). Point the endpoint at the
# S3-compatible endpoint of the chosen provider (e.g. Cloudflare R2).
STORAGE_DISK=local
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_USE_PATH_STYLE_ENDPOINT=false
STORAGE_TEMPORARY_URL_TTL=300

# Comma-separated allowed CORS origins. Wildcards ("*") are supported.
# The ".jualantar.test" entries are the frontend origins (see each frontend's
# allowedHosts/allowedDevOrigins): landing on the apex domain and the
# admin/merchant/driver/app Vite dev servers on subdomains. The ":*" variants
# cover dev servers served on a non-standard port.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://jualantar.test,http://jualantar.test:*,http://*.jualantar.test,http://*.jualantar.test:*
# Optional regex patterns (fruitcake/php-cors). Leave empty by default.
CORS_ALLOWED_ORIGINS_PATTERNS=
# For LAN/mobile development, additionally allow private-network wildcards, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://jualantar.test,http://jualantar.test:*,http://*.jualantar.test,http://*.jualantar.test:*,http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*
